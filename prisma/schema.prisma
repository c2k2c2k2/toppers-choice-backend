}

model NoteAccessLog {
  id                String                 @id @default(cuid())
  siteId            String
  noteId            String
  userId            String?
  noteViewSessionId String?
  eventType         NoteAccessLogEventType
  rangeStart        Int?
  rangeEnd          Int?
  bytesServed       Int?
