  userAgent         String?
  metaJson          Json?
  createdAt         DateTime               @default(now())
  site              Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  note              Note                   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  noteViewSession   NoteViewSession?       @relation(fields: [noteViewSessionId], references: [id], onDelete: SetNull)

  @@index([siteId, noteId, createdAt])
  @@index([siteId, userId, createdAt])
  @@index([noteViewSessionId, createdAt])
  @@map("note_access_logs")
}

model NoteSecuritySignal {
  id                String                 @id @default(cuid())
