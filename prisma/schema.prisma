generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum ConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ConfigVisibility {
  PUBLIC
  INTERNAL
}

enum UserType {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum RefreshSessionStatus {
  ACTIVE
  ROTATED
  REVOKED
  COMPROMISED
}

enum TokenPurpose {
  PASSWORD_RESET
}

enum CatalogVisibility {
  PUBLIC
  AUTHENTICATED
  INTERNAL
}

enum FileAssetPurpose {
  NOTE_PDF
  CMS_IMAGE
  QUESTION_IMAGE
  PROFILE_IMAGE
  CONTENT_IMAGE
  CONTENT_AUDIO
  GENERIC_PDF
  GENERIC_IMAGE
}

enum FileAssetStatus {
  PENDING_UPLOAD
  READY
  REVOKED
}

enum FileAssetAccess {
  PUBLIC
  AUTHENTICATED
  PROTECTED
  ADMIN_ONLY
}

enum NoteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NoteAccessType {
  FREE
  PREVIEWABLE_PREMIUM
  PREMIUM_ONLY
}

enum NoteViewSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum NoteViewAccessMode {
  FULL
  PREVIEW
}

enum NoteAccessLogEventType {
  VIEW_SESSION_CREATED
  WATERMARK_FETCHED
  CONTENT_STREAMED
  PROGRESS_UPDATED
}

enum SecuritySignalSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ContentFamily {
  CAREER_GUIDANCE
  INTERVIEW_GUIDANCE
  ENGLISH_SPEAKING
  CURRENT_AFFAIRS
  MONTHLY_UPDATE
}

enum ContentFormat {
  ARTICLE
  LESSON
  FEED_ITEM
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnglishSpeakingLanguage {
  HINDI
  MARATHI
  ENGLISH
}

enum EnglishSpeakingAudioStatus {
  NOT_GENERATED
  PREVIEW_READY
  FINALIZED
  FAILED
}

enum ContentAccessType {
  FREE
  PREMIUM
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT_INPUT
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionMediaUsage {
  STATEMENT
  OPTION
  EXPLANATION
}

enum PracticeMode {
  TOPIC_WISE
  MIXED
}

enum PracticeSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum PracticeQuestionEventType {
  SERVED
  SAVED
  ANSWERED
  REVEALED
}

enum TestFamily {
  SUBJECT_WISE
  MIXED
  EXAM_STYLE
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestAccessType {
  FREE
  PREMIUM
}

enum TestAttemptStatus {
  ACTIVE
  SUBMITTED
  AUTO_SUBMITTED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EntitlementKind {
  NOTES_PREMIUM
  CONTENT_PREMIUM
  PRACTICE_PREMIUM
  TESTS_PREMIUM
  ALL_PREMIUM
}

enum EntitlementSourceType {
  PLAN_PURCHASE
  ADMIN_GRANT
  SYSTEM_ADJUSTMENT
}

enum TrialAccessStatus {
  ACTIVE
  EXHAUSTED
  DISABLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  REVOKED
}

enum PaymentProvider {
  PHONEPE_STANDARD
  HDFC_SMARTGATEWAY
}

enum PaymentOrderStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PaymentEventSource {
  CHECKOUT_RESPONSE
  CALLBACK
  STATUS_POLL
  RECONCILIATION
}

enum CmsRecordStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CmsBannerPlacement {
  LANDING_HOME
  STUDENT_HOME
  COMMON
}

enum CmsSectionSurface {
  LANDING_HOME
  STUDENT_HOME
}

enum CmsSectionType {
  RICH_TEXT
  CONTENT_FEED
  PLAN_HIGHLIGHTS
  CTA_GROUP
}

enum CmsAnnouncementLevel {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum NotificationBroadcastStatus {
  DRAFT
  QUEUED
  SENT
  CANCELLED
  FAILED
}

enum NotificationMessageStatus {
  PENDING
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum NotificationAudienceType {
  ALL_STUDENTS
  ALL_ADMINS
  USER_IDS
  ACTIVE_SUBSCRIBERS
}

enum IdempotencyRecordStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model Site {
  id                       String                        @id @default(cuid())
  code                     String                        @unique
  slug                     String                        @unique
  name                     String
  primaryDomain            String?
  defaultLocale            String                        @default("mr-IN")
  timezone                 String                        @default("Asia/Kolkata")
  status                   SiteStatus                    @default(ACTIVE)
  isDefault                Boolean                       @default(false)
  configs                  SiteConfigVersion[]
  users                    User[]
  refreshSessions          RefreshSession[]
  passwordResetTokens      PasswordResetToken[]
  roles                    Role[]
  auditLogs                AuditLog[]
  plans                    Plan[]
  planEntitlements         PlanEntitlement[]
  subscriptions            Subscription[]
  entitlements             Entitlement[]
  trialAccesses            TrialAccess[]
  trialUsageEvents         TrialUsageEvent[]
  paymentOrders            PaymentOrder[]
  paymentTransactions      PaymentTransaction[]
  paymentEvents            PaymentEvent[]
  cmsPages                 CmsPage[]
  cmsBanners               CmsBanner[]
  cmsAnnouncements         CmsAnnouncement[]
  cmsSections              CmsSection[]
  notificationTemplates    NotificationTemplate[]
  notificationBroadcasts   NotificationBroadcast[]
  notificationMessages     NotificationMessage[]
  notificationPreferences  NotificationPreference[]
  idempotencyRecords       IdempotencyRecord[]
  examTracks               ExamTrack[]
  mediums                  Medium[]
  subjects                 Subject[]
  topics                   Topic[]
  tags                     Tag[]
  fileAssets               FileAsset[]
  fileAssetReferences      FileAssetReference[]
  contentEntries           ContentEntry[]
  englishSpeakingTopics    EnglishSpeakingTopic[]
  questions                Question[]
  practiceSessions         PracticeSession[]
  practiceSessionQuestions PracticeSessionQuestion[]
  practiceQuestionEvents   PracticeQuestionEvent[]
  questionPracticeStates   UserQuestionPracticeState[]
  subjectPracticeProgress  UserSubjectPracticeProgress[]
  topicPracticeProgress    UserTopicPracticeProgress[]
  tests                    Test[]
  testQuestions            TestQuestion[]
  testAttempts             TestAttempt[]
  testAttemptQuestions     TestAttemptQuestion[]
  notes                    Note[]
  noteIndexEntries         NoteIndexEntry[]
  noteBookmarks            NoteBookmark[]
  noteViewSessions         NoteViewSession[]
  noteProgressRecords      NoteProgress[]
  noteAccessLogs           NoteAccessLog[]
  noteSecuritySignals      NoteSecuritySignal[]
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  @@index([isDefault, status])
  @@map("sites")
}

model SiteConfigVersion {
  id          String           @id @default(cuid())
  siteId      String
  configKey   String
  version     Int
  status      ConfigStatus     @default(DRAFT)
  visibility  ConfigVisibility @default(INTERNAL)
  configJson  Json
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, configKey, version])
  @@index([siteId, configKey, status])
  @@index([siteId, visibility, status])
  @@map("site_config_versions")
}

model User {
  id                               String                        @id @default(cuid())
  siteId                           String
  email                            String
  phone                            String?
  fullName                         String
  passwordHash                     String
  userType                         UserType
  status                           UserStatus                    @default(ACTIVE)
  lastLoginAt                      DateTime?
  emailVerifiedAt                  DateTime?
  phoneVerifiedAt                  DateTime?
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt
  site                             Site                          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  refreshSessions                  RefreshSession[]
  passwordResetTokens              PasswordResetToken[]
  userRoles                        UserRole[]                    @relation("UserRolesSubject")
  roleAssignmentsMade              UserRole[]                    @relation("UserRolesActor")
  permissionOverrides              UserPermissionOverride[]      @relation("UserPermissionOverrideSubject")
  permissionOverridesMade          UserPermissionOverride[]      @relation("UserPermissionOverrideActor")
  auditLogsAuthored                AuditLog[]                    @relation("AuditLogsActor")
  createdFileAssets                FileAsset[]                   @relation("FileAssetCreator")
  confirmedFileAssets              FileAsset[]                   @relation("FileAssetConfirmer")
  createdContentEntries            ContentEntry[]                @relation("ContentCreator")
  updatedContentEntries            ContentEntry[]                @relation("ContentUpdater")
  publishedContentEntries          ContentEntry[]                @relation("ContentPublisher")
  createdQuestions                 Question[]                    @relation("QuestionCreator")
  updatedQuestions                 Question[]                    @relation("QuestionUpdater")
  publishedQuestions               Question[]                    @relation("QuestionPublisher")
  createdPlans                     Plan[]                        @relation("PlanCreator")
  updatedPlans                     Plan[]                        @relation("PlanUpdater")
  subscriptions                    Subscription[]
  entitlements                     Entitlement[]                 @relation("EntitlementSubject")
  grantedEntitlements              Entitlement[]                 @relation("EntitlementGrantActor")
  trialAccess                      TrialAccess?
  trialUsageEvents                 TrialUsageEvent[]
  paymentOrders                    PaymentOrder[]
  createdCmsPages                  CmsPage[]                     @relation("CmsPageCreator")
  updatedCmsPages                  CmsPage[]                     @relation("CmsPageUpdater")
  publishedCmsPages                CmsPage[]                     @relation("CmsPagePublisher")
  createdCmsBanners                CmsBanner[]                   @relation("CmsBannerCreator")
  updatedCmsBanners                CmsBanner[]                   @relation("CmsBannerUpdater")
  publishedCmsBanners              CmsBanner[]                   @relation("CmsBannerPublisher")
  createdCmsAnnouncements          CmsAnnouncement[]             @relation("CmsAnnouncementCreator")
  updatedCmsAnnouncements          CmsAnnouncement[]             @relation("CmsAnnouncementUpdater")
  publishedCmsAnnouncements        CmsAnnouncement[]             @relation("CmsAnnouncementPublisher")
  createdCmsSections               CmsSection[]                  @relation("CmsSectionCreator")
  updatedCmsSections               CmsSection[]                  @relation("CmsSectionUpdater")
  publishedCmsSections             CmsSection[]                  @relation("CmsSectionPublisher")
  createdNotificationTemplates     NotificationTemplate[]        @relation("NotificationTemplateCreator")
  updatedNotificationTemplates     NotificationTemplate[]        @relation("NotificationTemplateUpdater")
  createdNotificationBroadcasts    NotificationBroadcast[]       @relation("NotificationBroadcastCreator")
  updatedNotificationBroadcasts    NotificationBroadcast[]       @relation("NotificationBroadcastUpdater")
  dispatchedNotificationBroadcasts NotificationBroadcast[]       @relation("NotificationBroadcastDispatcher")
  notificationMessages             NotificationMessage[]
  notificationPreferences          NotificationPreference[]
  idempotencyRecords               IdempotencyRecord[]
  createdNotes                     Note[]                        @relation("NoteCreator")
  updatedNotes                     Note[]                        @relation("NoteUpdater")
  publishedNotes                   Note[]                        @relation("NotePublisher")
  createdNoteIndexEntries          NoteIndexEntry[]              @relation("NoteIndexEntryCreator")
  updatedNoteIndexEntries          NoteIndexEntry[]              @relation("NoteIndexEntryUpdater")
  noteBookmarks                    NoteBookmark[]
  practiceSessions                 PracticeSession[]
  practiceSessionQuestions         PracticeSessionQuestion[]
  practiceQuestionEvents           PracticeQuestionEvent[]
  questionPracticeStates           UserQuestionPracticeState[]
  subjectPracticeProgress          UserSubjectPracticeProgress[]
  topicPracticeProgress            UserTopicPracticeProgress[]
  createdTests                     Test[]                        @relation("TestCreator")
  updatedTests                     Test[]                        @relation("TestUpdater")
  publishedTests                   Test[]                        @relation("TestPublisher")
  testAttempts                     TestAttempt[]
  noteViewSessions                 NoteViewSession[]
  noteProgressRecords              NoteProgress[]
  noteAccessLogs                   NoteAccessLog[]
  noteSecuritySignals              NoteSecuritySignal[]

  @@unique([siteId, email])
  @@index([siteId, userType, status])
  @@index([siteId, status])
  @@map("users")
}

model RefreshSession {
  id                  String               @id
  siteId              String
  userId              String
  familyId            String
  tokenHash           String               @unique
  status              RefreshSessionStatus @default(ACTIVE)
  expiresAt           DateTime
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  revokedReason       String?
  ipAddress           String?
  userAgent           String?
  replacedBySessionId String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  site                Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBySession   RefreshSession?      @relation("RefreshSessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  previousSessions    RefreshSession[]     @relation("RefreshSessionRotation")

  @@index([siteId, userId, createdAt])
  @@index([userId, status, expiresAt])
  @@index([familyId, status])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id                 String       @id @default(cuid())
  siteId             String
  userId             String
  email              String
  purpose            TokenPurpose @default(PASSWORD_RESET)
  codeHash           String
  expiresAt          DateTime
  consumedAt         DateTime?
  invalidatedAt      DateTime?
  attemptCount       Int          @default(0)
  lastAttemptAt      DateTime?
  requestedIp        String?
  requestedUserAgent String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  site               Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([siteId, email, purpose, expiresAt])
  @@map("password_reset_tokens")
}

model Permission {
  id                      String                   @id @default(cuid())
  key                     String                   @unique
  category                String
  description             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@index([category, key])
  @@map("permissions")
}

model Role {
  id              String           @id @default(cuid())
  siteId          String
  code            String
  name            String
  description     String?
  userType        UserType         @default(ADMIN)
  isSystem        Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  site            Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([siteId, code])
  @@index([siteId, userType, isActive])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId           String
  roleId           String
  assignedByUserId String?
  assignedAt       DateTime @default(now())
  user             User     @relation("UserRolesSubject", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser   User?    @relation("UserRolesActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("user_roles")
}

model UserPermissionOverride {
  userId           String
  permissionId     String
  isAllowed        Boolean
  reason           String?
  assignedByUserId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation("UserPermissionOverrideSubject", fields: [userId], references: [id], onDelete: Cascade)
  permission       Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedByUser   User?      @relation("UserPermissionOverrideActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@index([assignedByUserId])
  @@map("user_permission_overrides")
}

model AuditLog {
  id           String   @id @default(cuid())
  siteId       String
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  metaJson     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  actorUser    User?    @relation("AuditLogsActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([siteId, action, createdAt])
  @@index([siteId, resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Plan {
  id               String            @id @default(cuid())
  siteId           String
  code             String
  slug             String
  name             String
  shortDescription String?
  description      String?
  pricePaise       Int
  currencyCode     String            @default("INR")
  durationDays     Int
  sortOrder        Int               @default(0)
  status           PlanStatus        @default(INACTIVE)
  metadataJson     Json?
  createdByUserId  String
  updatedByUserId  String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  site             Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdByUser    User              @relation("PlanCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser    User              @relation("PlanUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  planEntitlements PlanEntitlement[]
  subscriptions    Subscription[]
  paymentOrders    PaymentOrder[]
  grantedByPlan    Entitlement[]

  @@unique([siteId, code])
  @@unique([siteId, slug])
  @@index([siteId, status, sortOrder])
  @@map("plans")
}

model PlanEntitlement {
  id              String          @id @default(cuid())
  siteId          String
  planId          String
  entitlementKind EntitlementKind
  scopeJson       Json?
  orderIndex      Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  site            Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  plan            Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([siteId, entitlementKind])
  @@index([planId, orderIndex])
  @@map("plan_entitlements")
}

model Subscription {
  id             String             @id @default(cuid())
  siteId         String
  userId         String
  planId         String
  paymentOrderId String?            @unique
  status         SubscriptionStatus @default(PENDING)
  startsAt       DateTime
  endsAt         DateTime
  cancelledAt    DateTime?
  revokedAt      DateTime?
  revokedReason  String?
  metadataJson   Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  site           Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentOrder   PaymentOrder?      @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  entitlements   Entitlement[]

  @@index([siteId, userId, status, endsAt])
  @@index([siteId, planId, status, startsAt])
  @@map("subscriptions")
}

model Entitlement {
  id              String                @id @default(cuid())
  siteId          String
  userId          String
  planId          String?
  subscriptionId  String?
  paymentOrderId  String?
  grantedByUserId String?
  sourceType      EntitlementSourceType
  kind            EntitlementKind
  scopeJson       Json?
  startsAt        DateTime
  endsAt          DateTime?
  revokedAt       DateTime?
  revokedReason   String?
  metadataJson    Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  site            Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user            User                  @relation("EntitlementSubject", fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription    Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentOrder    PaymentOrder?         @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  grantedByUser   User?                 @relation("EntitlementGrantActor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([siteId, userId, kind, startsAt, endsAt])
  @@index([siteId, userId, revokedAt, endsAt])
  @@index([subscriptionId])
  @@index([paymentOrderId])
  @@map("entitlements")
}

model TrialAccess {
  id              String            @id @default(cuid())
  siteId          String
  userId          String            @unique
  status          TrialAccessStatus @default(ACTIVE)
  consumedSeconds Int               @default(0)
  startedAt       DateTime?
  lastHeartbeatAt DateTime?
  lastStoppedAt   DateTime?
  exhaustedAt     DateTime?
  disabledAt      DateTime?
  metadataJson    Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  site            Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents     TrialUsageEvent[]

  @@unique([siteId, userId])
  @@index([siteId, status, updatedAt])
  @@index([siteId, userId, status])
  @@map("trial_accesses")
}

model TrialUsageEvent {
  id               String      @id @default(cuid())
  siteId           String
  userId           String
  trialAccessId    String
  eventType        String
  chargedSeconds   Int         @default(0)
  consumedSeconds  Int
  remainingSeconds Int
  occurredAt       DateTime    @default(now())
  metadataJson     Json?
  createdAt        DateTime    @default(now())
  site             Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trialAccess      TrialAccess @relation(fields: [trialAccessId], references: [id], onDelete: Cascade)

  @@index([siteId, userId, occurredAt])
  @@index([trialAccessId, occurredAt])
  @@map("trial_usage_events")
}

model PaymentOrder {
  id                  String               @id @default(cuid())
  siteId              String
  userId              String
  planId              String
  provider            PaymentProvider
  merchantOrderCode   String               @unique
  amountPaise         Int
  currencyCode        String               @default("INR")
  status              PaymentOrderStatus   @default(CREATED)
  redirectUrl         String?
  providerOrderId     String?
  providerReferenceId String?
  providerStatus      String?
  callbackConfirmedAt DateTime?
  confirmedAt         DateTime?
  failedAt            DateTime?
  expiresAt           DateTime?
  lastCheckedAt       DateTime?
  metadataJson        Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  site                Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription        Subscription?
  entitlements        Entitlement[]
  transactions        PaymentTransaction[]
  events              PaymentEvent[]

  @@index([siteId, userId, status, createdAt])
  @@index([siteId, planId, status, createdAt])
  @@index([siteId, provider, status, createdAt])
  @@map("payment_orders")
}

model PaymentTransaction {
  id                    String                   @id @default(cuid())
  siteId                String
  paymentOrderId        String                   @unique
  provider              PaymentProvider
  providerTransactionId String?                  @unique
  providerReferenceId   String?
  status                PaymentTransactionStatus
  amountPaise           Int
  currencyCode          String                   @default("INR")
  occurredAt            DateTime?
  responseJson          Json?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  site                  Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  paymentOrder          PaymentOrder             @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  @@index([siteId, provider, status, createdAt])
  @@map("payment_transactions")
}

model PaymentEvent {
  id              String             @id @default(cuid())
  siteId          String
  paymentOrderId  String?
  provider        PaymentProvider
  source          PaymentEventSource
  eventType       String
  dedupeKey       String             @unique
  providerEventId String?
  status          PaymentEventStatus @default(RECEIVED)
  payloadJson     Json
  headersJson     Json?
  errorMessage    String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
