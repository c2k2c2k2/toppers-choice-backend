model Test {
  id                     String                @id @default(cuid())
  siteId                 String
  code                   String?
  slug                   String
  title                  String
  shortDescription       String?
  instructionsJson       Json?
  configJson             Json?
  family                 TestFamily
  examTrackId            String?
  mediumId               String?
  subjectId              String?
  durationMinutes        Int
  maxAttempts            Int                   @default(1)
  randomizeQuestionOrder Boolean               @default(false)
  questionCount          Int                   @default(0)
  maxScore               Float                 @default(0)
  availableFrom          DateTime?
  availableUntil         DateTime?
  status                 TestStatus            @default(DRAFT)
  createdByUserId        String
  updatedByUserId        String
  publishedByUserId      String?
  publishedAt            DateTime?
  archivedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  site                   Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  examTrack              ExamTrack?            @relation(fields: [examTrackId], references: [id], onDelete: SetNull)
  medium                 Medium?               @relation(fields: [mediumId], references: [id], onDelete: SetNull)
  subject                Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdByUser          User                  @relation("TestCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser          User                  @relation("TestUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  publishedByUser        User?                 @relation("TestPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  questions              TestQuestion[]
  attempts               TestAttempt[]
  attemptQuestions       TestAttemptQuestion[]

  @@unique([siteId, code])
  @@unique([siteId, slug])
  @@index([siteId, family, status, publishedAt])
  @@index([siteId, subjectId, status, publishedAt])
  @@index([siteId, examTrackId, status, publishedAt])
  @@index([siteId, availableFrom, availableUntil, status])
  @@map("tests")
}

model TestQuestion {
  id            String   @id @default(cuid())
  siteId        String
  testId        String
  questionId    String
  orderIndex    Int      @default(0)
  positiveMarks Float    @default(1)
  negativeMarks Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question      Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([testId, questionId])
  @@index([siteId, questionId])
  @@index([testId, orderIndex])
  @@map("test_questions")
}

model TestAttempt {
  id                  String                @id @default(cuid())
  siteId              String
  testId              String
  userId              String
  authSessionId       String?
  attemptNumber       Int
  status              TestAttemptStatus     @default(ACTIVE)
  testSnapshotJson    Json
  durationMinutes     Int
  questionCount       Int
  answeredCount       Int                   @default(0)
  correctCount        Int                   @default(0)
  wrongCount          Int                   @default(0)
  skippedCount        Int                   @default(0)
  score               Float                 @default(0)
  maxScore            Float                 @default(0)
  percentage          Int                   @default(0)
  timeTakenSeconds    Int?
  resultSummaryJson   Json?
  resultBreakdownJson Json?
  startedAt           DateTime              @default(now())
  expiresAt           DateTime
  lastSavedAt         DateTime?
  submittedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  site                Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  test                Test                  @relation(fields: [testId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions           TestAttemptQuestion[]

  @@unique([testId, userId, attemptNumber])
  @@index([siteId, userId, startedAt])
  @@index([siteId, testId, status, startedAt])
  @@index([siteId, userId, status, expiresAt])
  @@map("test_attempts")
}

model TestAttemptQuestion {
  id                    String             @id @default(cuid())
  siteId                String
  testAttemptId         String
  testId                String
  questionId            String
  orderIndex            Int                @default(0)
  questionCodeSnapshot  String?
  questionTypeSnapshot  QuestionType
  difficultySnapshot    QuestionDifficulty
  examTrackIdSnapshot   String
  mediumIdSnapshot      String?
  subjectIdSnapshot     String
  topicIdSnapshot       String?
  positiveMarks         Float
  negativeMarks         Float
  questionSnapshotJson  Json
  correctAnswerJson     Json
  explanationJson       Json?
  latestSavedAnswerJson Json?
  finalAnswerJson       Json?
  lastSavedAt           DateTime?
  answeredAt            DateTime?
  isCorrect             Boolean?
  awardedMarks          Float?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  site                  Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  testAttempt           TestAttempt        @relation(fields: [testAttemptId], references: [id], onDelete: Cascade)
  test                  Test               @relation(fields: [testId], references: [id], onDelete: Cascade)
  question              Question           @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([testAttemptId, questionId])
  @@index([siteId, questionId])
  @@index([siteId, subjectIdSnapshot])
  @@index([siteId, topicIdSnapshot])
  @@index([testAttemptId, orderIndex])
  @@map("test_attempt_questions")
}

model Note {
  id                 String               @id @default(cuid())
  siteId             String
  subjectId          String
  mediumId           String?
  slug               String
  title              String
  shortDescription   String?
  description        String?
  fullFileAssetId    String
  previewFileAssetId String?
  coverImageAssetId  String?
  accessType         NoteAccessType       @default(FREE)
  previewPageCount   Int?
  pageCount          Int
  orderIndex         Int                  @default(0)
  status             NoteStatus           @default(DRAFT)
  createdByUserId    String
  updatedByUserId    String
  publishedByUserId  String?
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  site               Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  subject            Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  medium             Medium?              @relation(fields: [mediumId], references: [id], onDelete: SetNull)
  fullFileAsset      FileAsset            @relation("NoteContentAsset", fields: [fullFileAssetId], references: [id], onDelete: Restrict)
  previewFileAsset   FileAsset?           @relation("NotePreviewAsset", fields: [previewFileAssetId], references: [id], onDelete: SetNull)
  coverImageAsset    FileAsset?           @relation("NoteCoverAsset", fields: [coverImageAssetId], references: [id], onDelete: SetNull)
  createdByUser      User                 @relation("NoteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser      User                 @relation("NoteUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  publishedByUser    User?                @relation("NotePublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  noteTopics         NoteTopic[]
  viewSessions       NoteViewSession[]
  progressRecords    NoteProgress[]
  accessLogs         NoteAccessLog[]
  securitySignals    NoteSecuritySignal[]

  @@unique([siteId, slug])
  @@index([siteId, status, orderIndex])
  @@index([siteId, subjectId, status, orderIndex])
  @@index([siteId, accessType, status])
  @@map("notes")
}

model NoteTopic {
  noteId    String
  topicId   String
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([noteId, topicId])
  @@index([topicId])
  @@map("note_topics")
}

model NoteViewSession {
  id               String                @id @default(cuid())
  siteId           String
  noteId           String
  userId           String
  authSessionId    String?
  tokenHash        String                @unique
  status           NoteViewSessionStatus @default(ACTIVE)
  accessMode       NoteViewAccessMode
  previewPageCount Int?
  watermarkSeed    String
  ipAddress        String?
  userAgent        String?
  lastAccessedAt   DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  site             Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  note             Note                  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLogs       NoteAccessLog[]
  securitySignals  NoteSecuritySignal[]

  @@index([siteId, noteId, userId, createdAt])
  @@index([siteId, status, expiresAt])
  @@map("note_view_sessions")
}

model NoteProgress {
  siteId            String
  noteId            String
  userId            String
  lastPageViewed    Int       @default(0)
  maxPageViewed     Int       @default(0)
  completionPercent Int       @default(0)
  lastViewedAt      DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  site              Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  note              Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([siteId, userId, lastViewedAt])
  @@map("note_progress")
}

model NoteAccessLog {
  id                String                 @id @default(cuid())
  siteId            String
  noteId            String
  userId            String?
  noteViewSessionId String?
  eventType         NoteAccessLogEventType
  rangeStart        Int?
  rangeEnd          Int?
  bytesServed       Int?
  ipAddress         String?
  userAgent         String?
  metaJson          Json?
  createdAt         DateTime               @default(now())
  site              Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  note              Note                   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  noteViewSession   NoteViewSession?       @relation(fields: [noteViewSessionId], references: [id], onDelete: SetNull)

  @@index([siteId, noteId, createdAt])
  @@index([siteId, userId, createdAt])
  @@index([noteViewSessionId, createdAt])
  @@map("note_access_logs")
}

model NoteSecuritySignal {
  id                String                 @id @default(cuid())
  siteId            String
  noteId            String
  userId            String?
  noteViewSessionId String?
  signalKey         String
  severity          SecuritySignalSeverity @default(LOW)
  metaJson          Json?
  createdAt         DateTime               @default(now())
  site              Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  note              Note                   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  noteViewSession   NoteViewSession?       @relation(fields: [noteViewSessionId], references: [id], onDelete: SetNull)

  @@index([siteId, noteId, createdAt])
  @@index([siteId, signalKey, createdAt])
  @@map("note_security_signals")
}
