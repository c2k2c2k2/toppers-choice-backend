generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum ConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ConfigVisibility {
  PUBLIC
  INTERNAL
}

enum UserType {
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum RefreshSessionStatus {
  ACTIVE
  ROTATED
  REVOKED
  COMPROMISED
}

enum TokenPurpose {
  PASSWORD_RESET
}

enum CatalogVisibility {
  PUBLIC
  AUTHENTICATED
  INTERNAL
}

enum FileAssetPurpose {
  NOTE_PDF
  CMS_IMAGE
  QUESTION_IMAGE
  PROFILE_IMAGE
  CONTENT_IMAGE
  GENERIC_PDF
  GENERIC_IMAGE
}

enum FileAssetStatus {
  PENDING_UPLOAD
  READY
  REVOKED
}

enum FileAssetAccess {
  PUBLIC
  AUTHENTICATED
  PROTECTED
  ADMIN_ONLY
}

enum NoteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NoteAccessType {
  FREE
  PREVIEWABLE_PREMIUM
  PREMIUM_ONLY
}

enum NoteViewSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum NoteViewAccessMode {
  FULL
  PREVIEW
}

enum NoteAccessLogEventType {
  VIEW_SESSION_CREATED
  WATERMARK_FETCHED
  CONTENT_STREAMED
  PROGRESS_UPDATED
}

enum SecuritySignalSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ContentFamily {
  CAREER_GUIDANCE
  INTERVIEW_GUIDANCE
  ENGLISH_SPEAKING
  CURRENT_AFFAIRS
  MONTHLY_UPDATE
}

enum ContentFormat {
  ARTICLE
  LESSON
  FEED_ITEM
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentAccessType {
  FREE
  PREMIUM
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT_INPUT
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionMediaUsage {
  STATEMENT
  OPTION
  EXPLANATION
}

enum PracticeMode {
  TOPIC_WISE
  MIXED
}

enum PracticeSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum PracticeQuestionEventType {
  SERVED
  SAVED
  ANSWERED
  REVEALED
}

enum TestFamily {
  SUBJECT_WISE
  MIXED
  EXAM_STYLE
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestAttemptStatus {
  ACTIVE
  SUBMITTED
  AUTO_SUBMITTED
}

model Site {
  id                       String                        @id @default(cuid())
  code                     String                        @unique
  slug                     String                        @unique
  name                     String
  primaryDomain            String?
  defaultLocale            String                        @default("mr-IN")
  timezone                 String                        @default("Asia/Kolkata")
  status                   SiteStatus                    @default(ACTIVE)
  isDefault                Boolean                       @default(false)
  configs                  SiteConfigVersion[]
  users                    User[]
  refreshSessions          RefreshSession[]
  passwordResetTokens      PasswordResetToken[]
  roles                    Role[]
  auditLogs                AuditLog[]
  examTracks               ExamTrack[]
  mediums                  Medium[]
  subjects                 Subject[]
  topics                   Topic[]
  tags                     Tag[]
  fileAssets               FileAsset[]
  fileAssetReferences      FileAssetReference[]
  contentEntries           ContentEntry[]
  questions                Question[]
  practiceSessions         PracticeSession[]
  practiceSessionQuestions PracticeSessionQuestion[]
  practiceQuestionEvents   PracticeQuestionEvent[]
  questionPracticeStates   UserQuestionPracticeState[]
  subjectPracticeProgress  UserSubjectPracticeProgress[]
  topicPracticeProgress    UserTopicPracticeProgress[]
  tests                    Test[]
  testQuestions            TestQuestion[]
  testAttempts             TestAttempt[]
  testAttemptQuestions     TestAttemptQuestion[]
  notes                    Note[]
  noteViewSessions         NoteViewSession[]
  noteProgressRecords      NoteProgress[]
  noteAccessLogs           NoteAccessLog[]
  noteSecuritySignals      NoteSecuritySignal[]
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  @@index([isDefault, status])
  @@map("sites")
}

model SiteConfigVersion {
  id          String           @id @default(cuid())
  siteId      String
  configKey   String
  version     Int
  status      ConfigStatus     @default(DRAFT)
  visibility  ConfigVisibility @default(INTERNAL)
  configJson  Json
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, configKey, version])
  @@index([siteId, configKey, status])
  @@index([siteId, visibility, status])
  @@map("site_config_versions")
}

model User {
  id                       String                        @id @default(cuid())
  siteId                   String
  email                    String
  phone                    String?
  fullName                 String
  passwordHash             String
  userType                 UserType
  status                   UserStatus                    @default(ACTIVE)
  lastLoginAt              DateTime?
  emailVerifiedAt          DateTime?
  phoneVerifiedAt          DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  site                     Site                          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  refreshSessions          RefreshSession[]
  passwordResetTokens      PasswordResetToken[]
  userRoles                UserRole[]                    @relation("UserRolesSubject")
  roleAssignmentsMade      UserRole[]                    @relation("UserRolesActor")
  permissionOverrides      UserPermissionOverride[]      @relation("UserPermissionOverrideSubject")
  permissionOverridesMade  UserPermissionOverride[]      @relation("UserPermissionOverrideActor")
  auditLogsAuthored        AuditLog[]                    @relation("AuditLogsActor")
  createdFileAssets        FileAsset[]                   @relation("FileAssetCreator")
  confirmedFileAssets      FileAsset[]                   @relation("FileAssetConfirmer")
  createdContentEntries    ContentEntry[]                @relation("ContentCreator")
  updatedContentEntries    ContentEntry[]                @relation("ContentUpdater")
  publishedContentEntries  ContentEntry[]                @relation("ContentPublisher")
  createdQuestions         Question[]                    @relation("QuestionCreator")
  updatedQuestions         Question[]                    @relation("QuestionUpdater")
  publishedQuestions       Question[]                    @relation("QuestionPublisher")
  createdNotes             Note[]                        @relation("NoteCreator")
  updatedNotes             Note[]                        @relation("NoteUpdater")
  publishedNotes           Note[]                        @relation("NotePublisher")
  practiceSessions         PracticeSession[]
  practiceSessionQuestions PracticeSessionQuestion[]
  practiceQuestionEvents   PracticeQuestionEvent[]
  questionPracticeStates   UserQuestionPracticeState[]
  subjectPracticeProgress  UserSubjectPracticeProgress[]
  topicPracticeProgress    UserTopicPracticeProgress[]
  createdTests             Test[]                        @relation("TestCreator")
  updatedTests             Test[]                        @relation("TestUpdater")
  publishedTests           Test[]                        @relation("TestPublisher")
  testAttempts             TestAttempt[]
  noteViewSessions         NoteViewSession[]
  noteProgressRecords      NoteProgress[]
  noteAccessLogs           NoteAccessLog[]
  noteSecuritySignals      NoteSecuritySignal[]

  @@unique([siteId, email])
  @@index([siteId, userType, status])
  @@index([siteId, status])
  @@map("users")
}

model RefreshSession {
  id                  String               @id
  siteId              String
  userId              String
  familyId            String
  tokenHash           String               @unique
  status              RefreshSessionStatus @default(ACTIVE)
  expiresAt           DateTime
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  revokedReason       String?
  ipAddress           String?
  userAgent           String?
  replacedBySessionId String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  site                Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBySession   RefreshSession?      @relation("RefreshSessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  previousSessions    RefreshSession[]     @relation("RefreshSessionRotation")

  @@index([siteId, userId, createdAt])
  @@index([userId, status, expiresAt])
  @@index([familyId, status])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id                 String       @id @default(cuid())
  siteId             String
  userId             String
  email              String
  purpose            TokenPurpose @default(PASSWORD_RESET)
  codeHash           String
  expiresAt          DateTime
  consumedAt         DateTime?
  invalidatedAt      DateTime?
  attemptCount       Int          @default(0)
  lastAttemptAt      DateTime?
  requestedIp        String?
  requestedUserAgent String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  site               Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@index([siteId, email, purpose, expiresAt])
  @@map("password_reset_tokens")
}

model Permission {
  id                      String                   @id @default(cuid())
  key                     String                   @unique
  category                String
  description             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@index([category, key])
  @@map("permissions")
}

model Role {
  id              String           @id @default(cuid())
  siteId          String
  code            String
  name            String
  description     String?
  userType        UserType         @default(ADMIN)
  isSystem        Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  site            Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([siteId, code])
  @@index([siteId, userType, isActive])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId           String
  roleId           String
  assignedByUserId String?
  assignedAt       DateTime @default(now())
  user             User     @relation("UserRolesSubject", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser   User?    @relation("UserRolesActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
  @@map("user_roles")
}

model UserPermissionOverride {
  userId           String
  permissionId     String
  isAllowed        Boolean
  reason           String?
  assignedByUserId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation("UserPermissionOverrideSubject", fields: [userId], references: [id], onDelete: Cascade)
  permission       Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedByUser   User?      @relation("UserPermissionOverrideActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@index([assignedByUserId])
  @@map("user_permission_overrides")
}

model AuditLog {
  id           String   @id @default(cuid())
  siteId       String
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  metaJson     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  actorUser    User?    @relation("AuditLogsActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([siteId, action, createdAt])
  @@index([siteId, resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model ExamTrack {
  id               String                  @id @default(cuid())
  siteId           String
  code             String
  slug             String
  name             String
  shortName        String?
  description      String?
  orderIndex       Int                     @default(0)
  visibility       CatalogVisibility       @default(PUBLIC)
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  site             Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentEntries   ContentEntryExamTrack[]
  subjects         Subject[]
  practiceSessions PracticeSession[]
  tests            Test[]

  @@unique([siteId, code])
  @@unique([siteId, slug])
  @@index([siteId, isActive, orderIndex])
  @@index([siteId, visibility, orderIndex])
  @@map("exam_tracks")
}

model Medium {
  id               String               @id @default(cuid())
  siteId           String
  code             String
  slug             String
  name             String
  description      String?
  orderIndex       Int                  @default(0)
  visibility       CatalogVisibility    @default(PUBLIC)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  site             Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  contentEntries   ContentEntryMedium[]
  questions        Question[]
  practiceSessions PracticeSession[]
  tests            Test[]
  notes            Note[]

  @@unique([siteId, code])
  @@unique([siteId, slug])
  @@index([siteId, isActive, orderIndex])
  @@index([siteId, visibility, orderIndex])
  @@map("mediums")
}

model Subject {
  id                      String                        @id @default(cuid())
  siteId                  String
  examTrackId             String
  code                    String
  slug                    String
  name                    String
  description             String?
  orderIndex              Int                           @default(0)
  visibility              CatalogVisibility             @default(PUBLIC)
  isActive                Boolean                       @default(true)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  site                    Site                          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  examTrack               ExamTrack                     @relation(fields: [examTrackId], references: [id], onDelete: Cascade)
  questions               Question[]
  practiceSessions        PracticeSession[]
  subjectPracticeProgress UserSubjectPracticeProgress[]
  topicPracticeProgress   UserTopicPracticeProgress[]
  tests                   Test[]
  topics                  Topic[]
  notes                   Note[]

  @@unique([siteId, examTrackId, code])
  @@unique([siteId, examTrackId, slug])
  @@index([siteId, examTrackId, isActive, orderIndex])
  @@index([siteId, visibility, orderIndex])
  @@map("subjects")
}

model Topic {
  id                    String                      @id @default(cuid())
  siteId                String
  subjectId             String
  parentId              String?
  code                  String
  slug                  String
  name                  String
  description           String?
  orderIndex            Int                         @default(0)
  visibility            CatalogVisibility           @default(PUBLIC)
  isActive              Boolean                     @default(true)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  site                  Site                        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  subject               Subject                     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent                Topic?                      @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children              Topic[]                     @relation("TopicHierarchy")
  questions             Question[]
  practiceSessions      PracticeSession[]
  topicPracticeProgress UserTopicPracticeProgress[]
  noteTopics            NoteTopic[]

  @@unique([siteId, subjectId, code])
  @@unique([siteId, subjectId, slug])
  @@index([siteId, visibility, orderIndex])
  @@index([subjectId, parentId, orderIndex])
  @@map("topics")
}

model Tag {
  id          String            @id @default(cuid())
  siteId      String
  code        String
  slug        String
  name        String
  description String?
  orderIndex  Int               @default(0)
  visibility  CatalogVisibility @default(PUBLIC)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  site        Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, code])
  @@unique([siteId, slug])
  @@index([siteId, isActive, orderIndex])
  @@index([siteId, visibility, orderIndex])
  @@map("tags")
}

model FileAsset {
  id                      String                   @id @default(cuid())
  siteId                  String
  createdByUserId         String
  confirmedByUserId       String?
  purpose                 FileAssetPurpose
  accessLevel             FileAssetAccess          @default(PROTECTED)
  status                  FileAssetStatus          @default(PENDING_UPLOAD)
  objectKey               String                   @unique
  originalFileName        String
  extension               String?
  contentType             String
  declaredSizeBytes       Int?
  sizeBytes               Int?
  checksumSha256          String?
  etag                    String?
  imageWidth              Int?
  imageHeight             Int?
  uploadExpiresAt         DateTime?
  confirmedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  site                    Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdByUser           User                     @relation("FileAssetCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedByUser         User?                    @relation("FileAssetConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  references              FileAssetReference[]
  contentCoverEntries     ContentEntry[]           @relation("ContentCoverAsset")
  contentAttachments      ContentAttachment[]
  questionMediaReferences QuestionMediaReference[]
  contentNotes            Note[]                   @relation("NoteContentAsset")
  previewNotes            Note[]                   @relation("NotePreviewAsset")
  coverNotes              Note[]                   @relation("NoteCoverAsset")

  @@index([siteId, purpose, createdAt])
  @@index([siteId, status, createdAt])
  @@index([createdByUserId, createdAt])
  @@map("file_assets")
}

model FileAssetReference {
  id           String           @id @default(cuid())
  siteId       String
  fileAssetId  String
  resourceType String
  resourceId   String
  slot         String?
  accessLevel  FileAssetAccess?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  site         Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset        @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)

  @@unique([fileAssetId, resourceType, resourceId, slot])
  @@index([siteId, resourceType, resourceId])
  @@index([fileAssetId, accessLevel])
  @@map("file_asset_references")
}

model ContentEntry {
  id                 String                  @id @default(cuid())
  siteId             String
  family             ContentFamily
  format             ContentFormat           @default(ARTICLE)
  visibility         CatalogVisibility       @default(PUBLIC)
  accessType         ContentAccessType       @default(FREE)
  slug               String
  title              String
  excerpt            String?
  bodyJson           Json
  metaJson           Json?
  coverImageAssetId  String?
  orderIndex         Int                     @default(0)
  isFeatured         Boolean                 @default(false)
  featuredOrderIndex Int?
  readingTimeMinutes Int?
  status             ContentStatus           @default(DRAFT)
  createdByUserId    String
  updatedByUserId    String
  publishedByUserId  String?
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  site               Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  coverImageAsset    FileAsset?              @relation("ContentCoverAsset", fields: [coverImageAssetId], references: [id], onDelete: SetNull)
  createdByUser      User                    @relation("ContentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser      User                    @relation("ContentUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  publishedByUser    User?                   @relation("ContentPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  examTrackLinks     ContentEntryExamTrack[]
  mediumLinks        ContentEntryMedium[]
  attachments        ContentAttachment[]

  @@unique([siteId, slug])
  @@index([siteId, family, status, publishedAt])
  @@index([siteId, visibility, status, publishedAt])
  @@index([siteId, accessType, status])
  @@index([siteId, isFeatured, featuredOrderIndex])
  @@map("content_entries")
}

model ContentEntryExamTrack {
  contentEntryId String
  examTrackId    String
  createdAt      DateTime     @default(now())
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)
  examTrack      ExamTrack    @relation(fields: [examTrackId], references: [id], onDelete: Cascade)

  @@id([contentEntryId, examTrackId])
  @@index([examTrackId])
  @@map("content_entry_exam_tracks")
}

model ContentEntryMedium {
  contentEntryId String
  mediumId       String
  createdAt      DateTime     @default(now())
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)
  medium         Medium       @relation(fields: [mediumId], references: [id], onDelete: Cascade)

  @@id([contentEntryId, mediumId])
  @@index([mediumId])
  @@map("content_entry_mediums")
}

model ContentAttachment {
  id             String       @id @default(cuid())
  contentEntryId String
  fileAssetId    String
  label          String?
  orderIndex     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)
  fileAsset      FileAsset    @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([contentEntryId, fileAssetId])
  @@index([fileAssetId])
  @@index([contentEntryId, orderIndex])
  @@map("content_attachments")
}

model Question {
  id                       String                      @id @default(cuid())
  siteId                   String
  code                     String?
  mediumId                 String?
  subjectId                String
  topicId                  String?
  type                     QuestionType
  difficulty               QuestionDifficulty          @default(MEDIUM)
  statementJson            Json
  explanationJson          Json?
  metadataJson             Json?
  correctAnswerJson        Json
  searchText               String
  hasMedia                 Boolean                     @default(false)
  status                   QuestionStatus              @default(DRAFT)
  createdByUserId          String
  updatedByUserId          String
  publishedByUserId        String?
  publishedAt              DateTime?
  archivedAt               DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  site                     Site                        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  medium                   Medium?                     @relation(fields: [mediumId], references: [id], onDelete: SetNull)
  subject                  Subject                     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic                    Topic?                      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdByUser            User                        @relation("QuestionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser            User                        @relation("QuestionUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  publishedByUser          User?                       @relation("QuestionPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  options                  QuestionOption[]
  mediaReferences          QuestionMediaReference[]
  practiceSessionQuestions PracticeSessionQuestion[]
  practiceQuestionEvents   PracticeQuestionEvent[]
  practiceStates           UserQuestionPracticeState[]
  testQuestions            TestQuestion[]
  testAttemptQuestions     TestAttemptQuestion[]

  @@unique([siteId, code])
  @@index([siteId, status, createdAt])
  @@index([siteId, difficulty, status])
  @@index([siteId, mediumId, status])
  @@index([siteId, subjectId, status])
  @@index([siteId, topicId, status])
  @@map("questions")
}

model QuestionOption {
  id          String   @id @default(cuid())
  questionId  String
  optionKey   String
  orderIndex  Int      @default(0)
  contentJson Json
  metaJson    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, optionKey])
  @@index([questionId, orderIndex])
  @@map("question_options")
}

model QuestionMediaReference {
  id          String             @id @default(cuid())
  questionId  String
  fileAssetId String
  usage       QuestionMediaUsage
  optionKey   String?
  localeCode  String?
  orderIndex  Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  question    Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  fileAsset   FileAsset          @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@unique([questionId, fileAssetId, usage, optionKey, localeCode])
  @@index([fileAssetId])
  @@index([questionId, usage, orderIndex])
  @@map("question_media_references")
}

model PracticeSession {
  id                  String                    @id @default(cuid())
  siteId              String
  userId              String
  authSessionId       String?
  mode                PracticeMode
  status              PracticeSessionStatus     @default(ACTIVE)
  examTrackId         String?
  mediumId            String?
  subjectId           String?
  topicId             String?
  difficulty          QuestionDifficulty?
  questionCountTarget Int                       @default(20)
  configJson          Json?
  servedCount         Int                       @default(0)
  answeredCount       Int                       @default(0)
  correctCount        Int                       @default(0)
  wrongCount          Int                       @default(0)
  revealedCount       Int                       @default(0)
  startedAt           DateTime                  @default(now())
  lastActivityAt      DateTime?
  endedAt             DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  site                Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  examTrack           ExamTrack?                @relation(fields: [examTrackId], references: [id], onDelete: SetNull)
  medium              Medium?                   @relation(fields: [mediumId], references: [id], onDelete: SetNull)
  subject             Subject?                  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic               Topic?                    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  practiceQuestions   PracticeSessionQuestion[]
  events              PracticeQuestionEvent[]

  @@index([siteId, userId, status, startedAt])
  @@index([siteId, mode, status, startedAt])
  @@index([siteId, subjectId, status, startedAt])
  @@index([siteId, topicId, status, startedAt])
  @@map("practice_sessions")
}

model PracticeSessionQuestion {
  id                    String                  @id @default(cuid())
  siteId                String
  userId                String
  practiceSessionId     String
  questionId            String
  orderIndex            Int                     @default(0)
  servedAt              DateTime                @default(now())
  latestSavedAnswerJson Json?
  lastSavedAt           DateTime?
  answerJson            Json?
  answeredAt            DateTime?
  isCorrect             Boolean?
  revealedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  site                  Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSession       PracticeSession         @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  question              Question                @relation(fields: [questionId], references: [id], onDelete: Cascade)
  events                PracticeQuestionEvent[]

  @@unique([practiceSessionId, questionId])
  @@index([siteId, userId, servedAt])
  @@index([practiceSessionId, orderIndex])
  @@index([questionId])
  @@map("practice_session_questions")
}

model PracticeQuestionEvent {
  id                        String                    @id @default(cuid())
  siteId                    String
  userId                    String
  practiceSessionId         String
  practiceSessionQuestionId String
  questionId                String
  eventType                 PracticeQuestionEventType
  answerJson                Json?
  isCorrect                 Boolean?
  responseTimeMs            Int?
  metaJson                  Json?
  createdAt                 DateTime                  @default(now())
  site                      Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user                      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSession           PracticeSession           @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  practiceSessionQuestion   PracticeSessionQuestion   @relation(fields: [practiceSessionQuestionId], references: [id], onDelete: Cascade)
  question                  Question                  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([siteId, userId, createdAt])
  @@index([practiceSessionId, createdAt])
  @@index([practiceSessionQuestionId, createdAt])
  @@index([siteId, questionId, createdAt])
  @@index([siteId, eventType, createdAt])
  @@map("practice_question_events")
}

model UserQuestionPracticeState {
  questionId     String
  userId         String
  siteId         String
  seenCount      Int       @default(0)
  answerCount    Int       @default(0)
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  revealCount    Int       @default(0)
  lastIsCorrect  Boolean?
  lastServedAt   DateTime?
  lastAnsweredAt DateTime?
  lastRevealedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([questionId, userId])
  @@index([siteId, userId, lastAnsweredAt])
  @@index([siteId, userId, wrongCount])
  @@index([siteId, userId, revealCount])
  @@map("user_question_practice_states")
}

model UserSubjectPracticeProgress {
