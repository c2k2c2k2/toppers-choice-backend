}

model Note {
  id                 String               @id @default(cuid())
  siteId             String
  subjectId          String
  mediumId           String?
  slug               String
  title              String
  shortDescription   String?
  description        String?
  fullFileAssetId    String
  previewFileAssetId String?
  coverImageAssetId  String?
  accessType         NoteAccessType       @default(FREE)
  previewPageCount   Int?
  pageCount          Int
  orderIndex         Int                  @default(0)
  status             NoteStatus           @default(DRAFT)
  createdByUserId    String
  updatedByUserId    String
  publishedByUserId  String?
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  site               Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  subject            Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  medium             Medium?              @relation(fields: [mediumId], references: [id], onDelete: SetNull)
  fullFileAsset      FileAsset            @relation("NoteContentAsset", fields: [fullFileAssetId], references: [id], onDelete: Restrict)
  previewFileAsset   FileAsset?           @relation("NotePreviewAsset", fields: [previewFileAssetId], references: [id], onDelete: SetNull)
  coverImageAsset    FileAsset?           @relation("NoteCoverAsset", fields: [coverImageAssetId], references: [id], onDelete: SetNull)
  createdByUser      User                 @relation("NoteCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser      User                 @relation("NoteUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  publishedByUser    User?                @relation("NotePublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  noteTopics         NoteTopic[]
  indexEntries       NoteIndexEntry[]
  bookmarks          NoteBookmark[]
  viewSessions       NoteViewSession[]
  progressRecords    NoteProgress[]
  accessLogs         NoteAccessLog[]
  securitySignals    NoteSecuritySignal[]

  @@unique([siteId, slug])
  @@index([siteId, status, orderIndex])
  @@index([siteId, subjectId, status, orderIndex])
  @@index([siteId, accessType, status])
  @@map("notes")
}

model NoteTopic {
  noteId    String
  topicId   String
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([noteId, topicId])
  @@index([topicId])
  @@map("note_topics")
}

model NoteIndexEntry {
  id              String         @id @default(cuid())
  siteId          String
  noteId          String
  serialLabel     String?
  title           String
  titleFontHint   String?
  pageNumber      Int
  indentLevel     Int            @default(0)
  orderIndex      Int            @default(0)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  site            Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  note            Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdByUser   User           @relation("NoteIndexEntryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser   User           @relation("NoteIndexEntryUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  bookmarks       NoteBookmark[]

  @@index([siteId, noteId, orderIndex])
  @@index([noteId, pageNumber])
  @@map("note_index_entries")
}

model NoteBookmark {
  id               String          @id @default(cuid())
  siteId           String
  noteId           String
  userId           String
  noteIndexEntryId String?
  label            String?
  pageNumber       Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  site             Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  note             Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteIndexEntry   NoteIndexEntry? @relation(fields: [noteIndexEntryId], references: [id], onDelete: SetNull)

  @@index([siteId, userId, noteId, createdAt])
  @@index([noteId, noteIndexEntryId])
  @@map("note_bookmarks")
}

model NoteViewSession {
  id               String                @id @default(cuid())
  siteId           String
  noteId           String
  userId           String
  authSessionId    String?
  tokenHash        String                @unique
  status           NoteViewSessionStatus @default(ACTIVE)
  accessMode       NoteViewAccessMode
  previewPageCount Int?
  watermarkSeed    String
  ipAddress        String?
  userAgent        String?
  lastAccessedAt   DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  site             Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  note             Note                  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLogs       NoteAccessLog[]
  securitySignals  NoteSecuritySignal[]

  @@index([siteId, noteId, userId, createdAt])
  @@index([siteId, status, expiresAt])
  @@map("note_view_sessions")
}

model NoteProgress {
  siteId            String
  noteId            String
  userId            String
  lastPageViewed    Int       @default(0)
  maxPageViewed     Int       @default(0)
  completionPercent Int       @default(0)
