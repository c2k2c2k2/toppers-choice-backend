model NotificationTemplate {
  id              String                     @id @default(cuid())
  siteId          String
  key             String
  name            String
  channel         NotificationChannel        @default(IN_APP)
  subjectTemplate String?
  titleTemplate   String
  bodyTemplate    String
  metaJson        Json?
  status          NotificationTemplateStatus @default(ACTIVE)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  site            Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdByUser   User                       @relation("NotificationTemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser   User                       @relation("NotificationTemplateUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  broadcasts      NotificationBroadcast[]
  messages        NotificationMessage[]

  @@unique([siteId, key])
  @@index([siteId, channel, status, name])
  @@map("notification_templates")
}

model NotificationBroadcast {
  id                 String                      @id @default(cuid())
  siteId             String
  templateId         String?
  audienceType       NotificationAudienceType
  channel            NotificationChannel         @default(IN_APP)
  title              String
  body               String
  filtersJson        Json?
  payloadJson        Json?
  scheduledAt        DateTime?
  dispatchedAt       DateTime?
  cancelledAt        DateTime?
  status             NotificationBroadcastStatus @default(DRAFT)
  recipientCount     Int                         @default(0)
  deliveredCount     Int                         @default(0)
  readCount          Int                         @default(0)
  createdByUserId    String
  updatedByUserId    String
  dispatchedByUserId String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  site               Site                        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  template           NotificationTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdByUser      User                        @relation("NotificationBroadcastCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser      User                        @relation("NotificationBroadcastUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  dispatchedByUser   User?                       @relation("NotificationBroadcastDispatcher", fields: [dispatchedByUserId], references: [id], onDelete: SetNull)
  messages           NotificationMessage[]

  @@index([siteId, status, createdAt])
  @@index([siteId, audienceType, status, dispatchedAt])
  @@map("notification_broadcasts")
}

model NotificationMessage {
  id            String                    @id @default(cuid())
  siteId        String
  userId        String
  templateId    String?
  broadcastId   String?
  channel       NotificationChannel       @default(IN_APP)
  title         String
  body          String
  payloadJson   Json?
  status        NotificationMessageStatus @default(PENDING)
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  site          Site                      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      NotificationTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  broadcast     NotificationBroadcast?    @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([siteId, userId, status, createdAt])
  @@index([siteId, broadcastId, createdAt])
  @@map("notification_messages")
}

model NotificationPreference {
  siteId    String
  userId    String
  channel   NotificationChannel
  isEnabled Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  site      Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channel])
  @@index([siteId, channel, isEnabled])
  @@map("notification_preferences")
}

model IdempotencyRecord {
  id           String                  @id @default(cuid())
  siteId       String
  userId       String?
  scope        String
  key          String
  requestHash  String
  status       IdempotencyRecordStatus @default(IN_PROGRESS)
  responseJson Json?
  resourceType String?
  resourceId   String?
  errorCode    String?
  completedAt  DateTime?
  expiresAt    DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  site         Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user         User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([siteId, scope, key])
  @@index([siteId, status, createdAt])
  @@index([siteId, userId, createdAt])
  @@map("idempotency_records")
}
