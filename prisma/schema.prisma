}

model UserTopicPracticeProgress {
  topicId         String
  userId          String
  siteId          String
  subjectId       String
  servedCount     Int       @default(0)
  answeredCount   Int       @default(0)
  correctCount    Int       @default(0)
  wrongCount      Int       @default(0)
  revealCount     Int       @default(0)
  accuracyPercent Int       @default(0)
  lastPracticedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  topic           Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subject         Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([topicId, userId])
  @@index([siteId, userId, lastPracticedAt])
  @@index([siteId, subjectId, userId, accuracyPercent])
  @@map("user_topic_practice_progress")
