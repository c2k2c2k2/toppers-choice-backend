NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SWAGGER_PATH=docs
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toppers_choice?schema=public
JWT_ACCESS_SECRET=toppers-choice-dev-access-secret
JWT_REFRESH_SECRET=toppers-choice-dev-refresh-secret
DEFAULT_SITE_CODE=toppers-choice
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
SITE_SETTINGS_CACHE_TTL_MS=30000
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=toppers-choice-private
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Optional PhonePe checkout provider secrets
# PHONEPE_API_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
# PHONEPE_MERCHANT_ID=YOUR_MERCHANT_ID
# PHONEPE_SALT_KEY=YOUR_SALT_KEY
# PHONEPE_SALT_INDEX=1
# Optional local bootstrap admin seed values
# SEED_ADMIN_FULL_NAME=Topper's Choice Admin
# SEED_ADMIN_EMAIL=admin@topperschoice.in
# SEED_ADMIN_PASSWORD=AdminPassword@123
# SEED_ADMIN_ROLE_CODES=admin.super_admin
